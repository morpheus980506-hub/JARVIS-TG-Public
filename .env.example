APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./jarvis_tg.db
FRONTEND_ORIGIN=http://localhost:5173

# DeepSeek: query /models with the account before selecting a model.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_FAST_MODEL=deepseek-flash

MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
MODEL_MAX_CONCURRENCY=3

# Real, keyless weather chain used by the MVP.
OPEN_METEO_ENABLED=true
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_JS_API_KEY=
# Keep this server-side. Do not expose it through VITE_* variables.
AMAP_JS_SECURITY_CODE=
QWEATHER_API_KEY=
QWEATHER_API_HOST=
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
VARIFLIGHT_MCP_KEY=
DIDI_MCP_KEY=
FLIGGY_API_KEY=
MEITUAN_HT_TOKEN=
VARIFLIGHT_MCP_URL=https://c-gw.variflight.com/chat_message/mcp/api
TOOL_TIMEOUT_SECONDS=15

