{
  "name": "travelagent",
  "version": "0.8.0",
  "private": true,
  "description": "Desktop travel planning agent",
  "author": "TravelAgent",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "start": "electron-forge start",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "electron-forge start -- --verify",
    "verify:account": "electron-forge start -- --verify-account",
    "verify:extra": "electron-forge start -- --verify-extra",
    "verify:package": "node scripts/check-package.cjs"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.6.1",
    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.2",
    "@langchain/mcp-adapters": "^2.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "cnfast": "0.2.0",
    "electron-squirrel-startup": "1.0.1",
    "highlight.js": "11.12.0",
    "lucide-react": "1.67.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.18.1",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "electron": "45.2.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "error"
    }
  },
  "productName": "TravelAgent"
}
