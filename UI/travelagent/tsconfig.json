{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "lib": ["ES2023", "DOM"],
    "paths": { "@/*": ["./src/renderer/*"] }
  },
  "include": ["src", "tests", "*.ts", "*.mts"]
}
